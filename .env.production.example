APP_NAME="Inventory & Order Management"
APP_ENV=production
APP_KEY=GENERATE_A_REAL_KEY
APP_DEBUG=false
APP_URL=https://inventory.example.com
APP_PORT=8088
API_TOKEN_EXPIRATION_HOURS=24
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inventory_management
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_PASSWORD
MYSQL_DATABASE=inventory_management
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_PASSWORD

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS=inventory@example.com
MAIL_FROM_NAME="Inventory System"
